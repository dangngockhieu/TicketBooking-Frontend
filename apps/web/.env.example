# Base URL của API Gateway (backend thật).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Đích proxy cho rewrite /api/* trong next.config.ts (server-side), thường trùng NEXT_PUBLIC_API_URL.
API_PROXY_TARGET=http://localhost:8080

# WebSocket phòng chờ ảo (STOMP).
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/queue

# URL của chính web này — dùng cho MoMo returnUrl và metadata SEO.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain lưu trữ ảnh banner sự kiện (next/image remotePatterns), phân tách bằng dấu phẩy.
NEXT_PUBLIC_IMAGE_HOSTNAMES=picsum.photos
