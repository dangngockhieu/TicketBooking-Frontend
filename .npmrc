# Cài phẳng kiểu npm thay vì cô lập theo symlink:
# - eslint-config-next require("next/...") mà không khai báo next; next-themes cần @types/react
#   ở cạnh — cả hai chỉ chạy khi các gói nằm ở node_modules gốc.
# - Metro (React Native/Expo, apps/mobile) cũng cần layout phẳng trong monorepo pnpm.
node-linker=hoisted
